// Zenith Software Hub - Prisma Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // PostgreSQL for production (Neon / Supabase / Railway)
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          String       @default("USER") // USER, ADMIN
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  accounts      Account[]
  sessions      Session[]
  savedItems    SavedItem[]
  downloadLogs  DownloadLog[]
  reviews       Review[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Category {
  id          String         @id @default(cuid())
  name        String         @unique
  slug        String         @unique
  description String?
  icon        String         // Lucide icon identifier: Gamepad2, Laptop, Smartphone, Swords
  orderIndex  Int            @default(0)
  items       SoftwareItem[]

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("categories")
}

model Tag {
  id        String        @id @default(cuid())
  name      String        @unique
  slug      String        @unique
  items     SoftwareTag[]

  @@map("tags")
}

model SoftwareItem {
  id                  String              @id @default(cuid())
  title               String
  slug                String              @unique
  tagline             String
  description         String
  detailedDescription String?
  developer           String
  publisher           String?
  releaseDate         DateTime            @default(now())
  version             String              @default("1.0.0")
  license             String              @default("FREE") // FREE, OPEN_SOURCE, FREEWARE, TRIAL, PAID
  isFeatured          Boolean             @default(false)
  isTrending          Boolean             @default(false)
  isTopRated          Boolean             @default(false)
  isPublished         Boolean             @default(true)
  downloadCount       Int                 @default(0)
  viewCount           Int                 @default(0)
  averageRating       Float               @default(0.0)
  ratingCount         Int                 @default(0)
  iconUrl             String
  heroBannerUrl       String?

  categoryId          String              @map("category_id")
  category            Category            @relation(fields: [categoryId], references: [id])

  tags                SoftwareTag[]
  screenshots         Screenshot[]
  downloadFiles       DownloadFile[]
  systemRequirements  SystemRequirement[]
  reviews             Review[]
  savedByUsers        SavedItem[]
  downloadLogs        DownloadLog[]

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([categoryId])
  @@index([slug])
  @@index([isFeatured, isTrending, isTopRated])
  @@map("software_items")
}

model SoftwareTag {
  softwareId String       @map("software_id")
  tagId      String       @map("tag_id")

  software   SoftwareItem @relation(fields: [softwareId], references: [id], onDelete: Cascade)
  tag        Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([softwareId, tagId])
  @@map("software_tags")
}

model Screenshot {
  id          String       @id @default(cuid())
  softwareId  String       @map("software_id")
  software    SoftwareItem @relation(fields: [softwareId], references: [id], onDelete: Cascade)
  url         String
  caption     String?
  orderIndex  Int          @default(0)

  @@index([softwareId])
  @@map("screenshots")
}

model DownloadFile {
  id            String        @id @default(cuid())
  softwareId    String        @map("software_id")
  software      SoftwareItem  @relation(fields: [softwareId], references: [id], onDelete: Cascade)
  platform      String        // WINDOWS, MACOS, LINUX, ANDROID, IOS
  architecture  String        @default("x64") // x64, arm64, universal, apk, ipa
  version       String
  fileName      String
  fileSize      BigInt        // File size in bytes
  formattedSize String        // e.g. "1.45 GB", "48 MB"
  fileHash      String?       // SHA-256 integrity checksum
  storageKey    String        // S3/R2 storage key or download route
  downloadCount Int           @default(0)
  isPrimary     Boolean       @default(false)
  createdAt     DateTime      @default(now())

  downloadLogs  DownloadLog[]

  @@index([softwareId])
  @@index([platform])
  @@map("download_files")
}

model SystemRequirement {
  id              String       @id @default(cuid())
  softwareId      String       @map("software_id")
  software        SoftwareItem @relation(fields: [softwareId], references: [id], onDelete: Cascade)
  platform        String       @default("WINDOWS") // WINDOWS, MACOS, LINUX, ANDROID, IOS
  reqType         String       @default("MINIMUM") // MINIMUM, RECOMMENDED
  os              String
  processor       String
  memory          String
  graphics        String
  storage         String
  directX         String?
  network         String?
  additionalNotes String?

  @@index([softwareId])
  @@map("system_requirements")
}

model Review {
  id                 String       @id @default(cuid())
  softwareId         String       @map("software_id")
  software           SoftwareItem @relation(fields: [softwareId], references: [id], onDelete: Cascade)
  userId             String       @map("user_id")
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating             Int          // 1 to 5 stars
  title              String
  comment            String
  isVerifiedDownload Boolean      @default(false)
  isApproved         Boolean      @default(true)
  helpfulVotes       Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([softwareId])
  @@index([userId])
  @@map("reviews")
}

// User-scoped Saved Items (Wishlist) with strict tenant isolation
model SavedItem {
  id         String       @id @default(cuid())
  userId     String       @map("user_id")
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  softwareId String       @map("software_id")
  software   SoftwareItem @relation(fields: [softwareId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())

  @@unique([userId, softwareId])
  @@index([userId])
  @@map("saved_items")
}

// User-scoped Isolated Download History
model DownloadLog {
  id           String        @id @default(cuid())
  userId       String?       @map("user_id")
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  softwareId   String        @map("software_id")
  software     SoftwareItem  @relation(fields: [softwareId], references: [id], onDelete: Cascade)
  fileId       String        @map("file_id")
  downloadFile DownloadFile  @relation(fields: [fileId], references: [id], onDelete: Cascade)
  ipAddress    String?       @map("ip_address")
  userAgent    String?       @map("user_agent")
  platform     String        @default("WINDOWS")
  status       String        @default("COMPLETED") // COMPLETED, FAILED, IN_PROGRESS
  createdAt    DateTime      @default(now())

  @@index([userId])
  @@index([softwareId])
  @@index([createdAt])
  @@map("download_logs")
}
