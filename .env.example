# ==============================================================================
# Zenith Software Hub - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for development or configure directly in Vercel.
# ==============================================================================

# Database Connection (PostgreSQL for production Neon/Supabase/Railway, SQLite for local dev)
DATABASE_URL="file:./dev.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://zenith_user:SuperSecretPassword123@ep-xyz-123.us-east-2.aws.neon.tech/zenith_hub?sslmode=require"

# NextAuth.js Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="zenith-hub-development-secret-change-this-in-production-min32chars"

# Initial Admin Credentials (used during seed and initial setup)
ADMIN_NAME="Tahir Abbas"
ADMIN_EMAIL="admin@zenithhub.com"
ADMIN_PASSWORD="AdminPassword123!"

# Object Storage (Cloudflare R2 / AWS S3 for binary files and screenshots)
# Options: "mock" (built-in zero config local streamer) | "r2" | "s3"
STORAGE_PROVIDER="mock"
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="zenith-software-hub"
R2_PUBLIC_DOMAIN="https://downloads.zenithhub.dev"
# AWS S3 Alternative (if not using Cloudflare R2):
# AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID="your_aws_key"
# AWS_SECRET_ACCESS_KEY="your_aws_secret"
# AWS_BUCKET_NAME="zenith-downloads"

# AI Chatbot LLM Provider (Google Gemini API / OpenAI API)
# If left empty, the intelligent built-in fallback grounded search engine will serve results!
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Optional OAuth Logins (GitHub / Google)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Rate Limiting & Security
DOWNLOAD_URL_EXPIRY_SECONDS=1800 # 30 minutes
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
