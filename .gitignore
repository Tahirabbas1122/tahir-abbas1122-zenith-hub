# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ==============================================================================
# SECRETS & LOCAL DATA — NEVER COMMIT THESE
# ==============================================================================
# All .env variants — real secrets live here (DB URL, NextAuth secret, passwords)
.env
.env.local
.env.development
.env.production
.env.test
# Allow the template (no real secrets inside)
!.env.example

# SQLite local development databases — binary data files, not source code
dev.db
dev.db-journal
dev.db-shm
dev.db-wal
/prisma/dev.db
/prisma/dev.db-journal
/prisma/dev.db-shm
/prisma/dev.db-wal
# ==============================================================================

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
